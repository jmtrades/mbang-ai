# Copy to deploy/.env and fill in. Never commit the filled file.
OPERATOR_DOMAIN=
OPERATOR_PUBLIC_URL=
OPERATOR_BRAND=Operator AI
OPERATOR_OWNER_DISPLAY=
OPERATOR_DEFAULT_TENANT=owner
OPERATOR_COOKIE_SECURE=1
OPERATOR_SESSION_HOURS=12
# AI (optional). With no key or a zero budget everything runs on rules/replays.
OPERATOR_LLM_PROVIDER=anthropic
OPERATOR_LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPERATOR_AI_TOKEN_BUDGET=0
OPERATOR_CRITIQUE_TOKEN_BUDGET=0
OPERATOR_BUILDER_AI=1
OPERATOR_BUILDER_DAILY_CAP=200
OPERATOR_DISABLE_LLM=0
# Integration secrets (Meta, Google, Telegram, Slack, SMS, payments ...) are NOT set here:
# enter them in the app (Owner → Integrations) — they go into the encrypted per-tenant vault.
# Offsite backups (optional)
OFFSITE_DEST=
RCLONE_REMOTE=
